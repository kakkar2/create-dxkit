{
  "name": "create-dxkit",
  "version": "2.0.5",
  "description": "CLI to add production-ready DX tooling to any project — Husky, commitlint, release-it and Prettier in one command.",
  "main": "src/cli.js",
  "bin": {
    "create-dxkit": "bin/index.js"
  },
  "type": "module",
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "dev": "node bin/index.js",
    "prepare": "husky",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "lint-staged": {
    "**/*.js": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "release-it": "^20.2.0"
  },
  "keywords": [
    "cli",
    "husky",
    "commitlint",
    "release-it",
    "prettier",
    "lint-staged",
    "git-hooks",
    "conventional-commits",
    "changelog",
    "developer-tools",
    "dx"
  ],
  "license": "MIT",
  "author": "Lalit Kakkar <lalitkakkar50@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakkar2/create-dxkit.git"
  },
  "homepage": "https://github.com/kakkar2/create-dxkit#readme",
  "bugs": {
    "url": "https://github.com/kakkar2/create-dxkit/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.3.5",
    "inquirer": "^9.3.8",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
